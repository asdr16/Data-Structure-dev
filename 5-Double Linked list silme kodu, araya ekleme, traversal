#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
    struct Node* prev;
};

// Listenin başı (head)
struct Node* head = NULL;

// Araya (belirli bir değerden sonraya) ekleme
void insertAfter(int hedef, int yeniVeri) {
    struct Node* temp = head;
    while (temp != NULL && temp->data != hedef) {
        temp = temp->next;
    }

    if (temp == NULL) {
        printf("%d degeri bulunamadı!\n", hedef);
        return;
    }

    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = yeniVeri;

    newNode->next = temp->next;
    newNode->prev = temp;

    if (temp->next != NULL) {
        temp->next->prev = newNode;
    }
    temp->next = newNode;
}

// Belirli bir değeri silme
void deleteNode(int veri) {
    struct Node* temp = head;
    while (temp != NULL && temp->data != veri) {
        temp = temp->next;
    }

    if (temp == NULL) return;

    if (temp->prev != NULL) {
        temp->prev->next = temp->next;
    } else {
        head = temp->next; // Silinen kafa (head) ise
    }

    if (temp->next != NULL) {
        temp->next->prev = temp->prev;
    }

    free(temp);
}

// Başa ekleme (Listeyi başlatmak/doldurmak için)
void insertFront(int yeniVeri) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = yeniVeri;
    newNode->next = head;
    newNode->prev = NULL;
    if (head != NULL) head->prev = newNode;
    head = newNode;
}

// Listeyi yazdırma (Traversal)
void printList() {
    struct Node* temp = head;
    printf("Liste: ");
    while (temp != NULL) {
        printf("%d <-> ", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

int main() {
    insertFront(10);
    insertFront(20);
    insertFront(30); // Liste: 30 <-> 20 <-> 10
    printList();

    printf("\n20'den sonra 25 ekleniyor...\n");
    insertAfter(20, 25);
    printList();

    printf("\n20 siliniyor...\n");
    deleteNode(20);
    printList();

    return 0;
}
