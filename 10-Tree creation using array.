#include <stdio.h>

#define MAX_SIZE 15

int tree[MAX_SIZE];

void initTree() {
    for (int i = 0; i < MAX_SIZE; i++) {
        tree[i] = -1;
    }
}

void setRoot(int data) {
    tree[0] = data;
}

void setLeft(int data, int parent) {
    int index = (2 * parent) + 1;
    if (index < MAX_SIZE) {
        tree[index] = data;
    }
}

void setRight(int data, int parent) {
    int index = (2 * parent) + 2;
    if (index < MAX_SIZE) {
        tree[index] = data;
    }
}

void printTree() {
    for (int i = 0; i < MAX_SIZE; i++) {
        if (tree[i] != -1)
            printf("Index %d: %d\n", i, tree[i]);
    }
}

int main() {
    initTree();
    
    setRoot(1);
    setLeft(2, 0);
    setRight(3, 0);
    setLeft(4, 1);
    setRight(5, 1);
    setLeft(6, 2);

    printTree();
    
    return 0;
}
